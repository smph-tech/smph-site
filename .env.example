# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Sheets (every enquiry is added as a row) -------------------------
# Email address of the service account (looks like name@project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private_key value from the service account JSON key. Keep the quotes and the \n sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Tab name inside the sheet. Defaults to Enquiries.
GOOGLE_SHEET_TAB=Enquiries

# --- Email (the owner is notified of every enquiry) --------------------------
# "resend" (default) or "smtp"
EMAIL_TRANSPORT=resend
# Inbox that receives the notifications. With onboarding@resend.dev this must be
# the email address that owns the Resend account.
CONTACT_TO_EMAIL=
# Sender. Use a verified domain address once you have one.
CONTACT_FROM_EMAIL="SMPH.Tech <onboarding@resend.dev>"
# Resend API key (resend.com > API Keys)
RESEND_API_KEY=
# Send the visitor a short "we got your message" email (needs a verified Resend domain,
# and only works when the visitor gave an email address). true or false.
SEND_AUTOREPLY=false

# --- SMTP fallback (only used when EMAIL_TRANSPORT=smtp) ----------------------
# Gmail example: smtp.gmail.com, 587, your address, and an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
