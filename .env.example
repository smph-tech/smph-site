# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Sheet via Apps Script (every enquiry is added as a row) ----------
# The web app URL from Deploy > Manage deployments. It ends in /exec.
APPS_SCRIPT_URL=
# Any long random string. Must be the same value as the SECRET script property in Apps Script.
APPS_SCRIPT_SECRET=
# Optional: link to the sheet, shown as a button in the owner email.
SHEET_URL=

# --- Email notification (OPTIONAL) -------------------------------------------
# Leave RESEND_API_KEY empty and no email is sent. Nothing breaks and nobody sees a warning.
# Resend API key (resend.com > API Keys)
RESEND_API_KEY=
# Inbox that receives the notifications. With onboarding@resend.dev this must be
# the email address that owns the Resend account.
CONTACT_TO_EMAIL=
# Sender. Use a verified domain address once you have one.
CONTACT_FROM_EMAIL="smph.tech <onboarding@resend.dev>"
# Send the visitor a short "we got your message" email (needs a verified Resend domain). true or false.
SEND_AUTOREPLY=false

# --- SMTP fallback (only used when EMAIL_TRANSPORT=smtp) ----------------------
# Gmail example: smtp.gmail.com, 587, your address, and an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
EMAIL_TRANSPORT=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
